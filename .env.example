# Server only. Use an HTTPS OpenAI-compatible endpoint with JSON object mode.
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
# Only set to 1 behind a proxy that overwrites untrusted forwarded headers.
TRUST_PROXY=0

# Public client configuration. Set in GitHub Actions repository variables for deployment.
VITE_AI_API_URL=http://localhost:8787
